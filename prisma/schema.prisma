// Candor data model (INT257).
//
// Prisma 7 notes for the viva:
//  - The datasource has no `url` here. The CLI reads connection strings from
//    prisma.config.mjs, and the running app passes its own to a driver adapter
//    (src/lib/prisma-client.js). That is what lets the app use Supabase's pooled
//    port while migrations use the session port.
//  - The `prisma-client` generator writes the client into src/generated (git-ignored, rebuilt by
//    `prisma generate` on install and before build). Prisma writes it as TypeScript files; the app is
//    plain JavaScript and imports it like any other module, and Next.js compiles it. With no tsconfig
//    to infer from, the generator block states the module format and import style itself.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum InterviewCategory {
  FRONTEND
  BACKEND
  DSA
  SYSTEM_DESIGN
  BEHAVIOURAL
  FULLSTACK_NEXT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// PRACTICE (the default) is private: nothing is watched. ASSESSMENT turns on the camera and focus
/// checks, and can only be booked once the candidate has agreed (Interview.monitoringConsentAt).
enum InterviewMode {
  PRACTICE
  ASSESSMENT
}

/// What the integrity monitor can report. Mirrored by INTEGRITY_EVENT_TYPES in
/// src/lib/integrity/constants.js; tests/integrity-enums.test.js fails if the two drift apart.
enum IntegrityEventType {
  FACE_MISSING
  MULTIPLE_FACES
  LOOKING_AWAY
  TAB_HIDDEN
  FOCUS_LOST
  PASTE
  CAMERA_OFF
}

// ── Users and Auth.js tables ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  /// bcrypt hash. Null for accounts created through Google.
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  accounts   Account[]
  sessions   Session[]
  interviews Interview[]
  resume     Resume?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Only used by the Auth.js adapter when sessions are stored in the database.
/// Candor uses JWT sessions, so this table stays empty, but the adapter expects it.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

// ── Product tables ─────────────────────────────────────────────────────────

/// One résumé per user. The PDF itself lives in a private Supabase Storage
/// bucket; this row stores where it is and what it is called.
model Resume {
  id          String   @id @default(cuid())
  userId      String   @unique
  fileName    String
  /// Object path inside the bucket: `<userId>/<uuid>.pdf`.
  storagePath String   @unique
  sizeBytes   Int
  uploadedAt  DateTime @default(now()) @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]
}

model Interview {
  id                  String            @id @default(cuid())
  userId              String
  /// Set when the user asked for questions tailored to their résumé.
  resumeId            String?
  category            InterviewCategory
  difficulty          Difficulty        @default(INTERMEDIATE)
  /// PRACTICE is private. ASSESSMENT watches for the events in IntegrityEventType.
  mode                InterviewMode     @default(PRACTICE)
  /// When the candidate agreed to the checks. A CHECK constraint in the integrity_monitoring
  /// migration makes it mandatory for ASSESSMENT (Prisma has no syntax for CHECK constraints).
  monitoringConsentAt DateTime?         @db.Timestamptz(3)
  scheduledAt         DateTime          @db.Timestamptz(3)
  durationMin         Int               @default(30)
  status              InterviewStatus   @default(SCHEDULED)
  /// Questions and the candidate's answers. Validated by transcriptSchema.
  transcript          Json?
  startedAt           DateTime?         @db.Timestamptz(3)
  completedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  feedback        Feedback?
  integrityEvents IntegrityEvent[]

  /// "My interviews" tabs and the active-bookings limit.
  @@index([userId, status, scheduledAt])
  /// Seat counts for a day of slots.
  @@index([scheduledAt, status])
  @@index([resumeId])
}

model Feedback {
  id           String   @id @default(cuid())
  interviewId  String   @unique
  /// 0-100, computed on the server from the per-question scores.
  overallScore Int
  /// The full report. Validated by evaluationSchema before it is written and when it is read.
  evaluation   Json
  /// Which model produced it, e.g. `gemini-3.8-flash` or `candor-rubric-v1`.
  model        String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// One thing the integrity monitor noticed during an ASSESSMENT interview. Only facts about the
/// session are kept: what, when, for how long and on which question. Never video, images or text.
model IntegrityEvent {
  id          String             @id @default(cuid())
  interviewId String
  type        IntegrityEventType
  /// The question that was on screen when it began (an id from Interview.transcript), if known.
  questionId  String?
  /// When it began, by the candidate's clock. The service rejects times far outside the session.
  startedAt   DateTime           @db.Timestamptz(3)
  /// 0 for instant events such as a paste.
  durationMs  Int                @default(0)
  /// Only ever `{ "chars": <number> }`, for a paste. A CHECK constraint refuses anything else,
  /// so free text cannot be stored here even by a bug.
  detail      Json?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  /// One interview's events in time order, for the report.
  @@index([interviewId, startedAt])
}
