# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (Prisma CLI and Next.js both read it) and fill it in.
# Never commit the real file. See docs/DEPLOYMENT.md for where each value lives.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (Supabase → Connect button → copy the strings WHOLE) ──────────
# Do not type the host yourself: the number in `aws-0-` / `aws-1-` depends on your project.
# Runtime queries use the pooled "Transaction" string (port 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations use the "Session" pooler string (port 5432), which supports IPv4.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
# Set to "disable" only when running against a local Postgres without TLS.
# DATABASE_SSL=disable

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (works on Windows, macOS and Linux; `openssl rand -base64 32` also works where openssl exists)
AUTH_SECRET=""
# Optional Google sign-in. The button only appears when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Supabase Storage (résumé PDFs) ─────────────────────────────────────────
# SERVER ONLY. Supabase → Settings → API Keys → the "secret" key (sb_secret_…), or the legacy service_role key.
# It bypasses row-level security. Never prefix it NEXT_PUBLIC.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="resumes"

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
# AI_MODE=gemini  → real model calls (needs GEMINI_API_KEY)
# AI_MODE=mock    → offline rubric evaluator, useful for demos without a key
# Leave AI_MODE empty to auto-select: gemini when a key is present, mock otherwise.
AI_MODE=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# When Gemini is down or keeps replying with unusable JSON, use the offline evaluator instead of
# failing the request. Defaults to true. Set to "false" to see real AI errors while developing.
# AI_FALLBACK="true"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# When true, a SCHEDULED interview can be started at any time (handy for demos and the viva).
DEMO_MODE="true"
